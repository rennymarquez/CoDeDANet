# Data / cache / output folders generated by the scripts (see setup.m).
# Keep the folders' own README files, ignore everything else in them.
/datasets/*
!/datasets/README.md
/CreateData/
/Results/

# MATLAB-generated artifacts
*.mat
*.asv
*.m~
slprj/
*.autosave

# Generic OS / editor junk
.DS_Store
Thumbs.db
*.swp

/third_party/
